        "import tensorflow as tf\n",
        "from tensorflow.keras import layers, models, Input\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Set student roll number for verification/reproducibility\n",
        "STUDENT_ROLL_NO = \"2024-CS-101\"  # <--- REPLACE WITH YOUR ACTUAL ROLL NUMBER\n",
        "tf.random.set_seed(42)\n",
        "np.random.seed(42)\n",
        "\n",
        "print(f\"Running Experiment for Student Roll No: {STUDENT_ROLL_NO}\")\n",
        "print(f\"TensorFlow Version: {tf.__version__}\\n\")\n",
        "\n",
        "# 1. Load and Preprocess Dataset (Fashion-MNIST)\n",
        "(X_train, y_train), (X_test, y_test) = tf.keras.datasets.fashion_mnist.load_data()\n",
        "\n",
        "# Normalize pixel values to range [0, 1]\n",
        "X_train = X_train / 255.0\n",
        "X_test = X_test / 255.0\n",
        "\n",
        "# 2. Function to Build Identical ANN Model Architecture\n",
        "def build_model(activation_function):\n",
        "    model = models.Sequential([\n",
        "        Input(shape=(28, 28), name=f\"input_layer_{activation_function}\"),\n",
        "        layers.Flatten(),\n",
        "        layers.Dense(128, activation=activation_function, name=f\"hidden_layer_1_{activation_function}\"),\n",
        "        layers.Dense(64, activation=activation_function, name=f\"hidden_layer_2_{activation_function}\"),\n",
        "        layers.Dense(10, activation='softmax', name=f\"output_layer_{activation_function}\")  # Softmax for 10-class output\n",
        "    ])\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),\n",
        "        loss='sparse_categorical_crossentropy',\n",
        "        metrics=['accuracy']\n",
        "    )\n",
        "    return model\n",
        "\n",
        "# 3. Train Models with Different Activation Functions\n",
        "activation_list = ['sigmoid', 'tanh', 'relu']\n",
        "histories = {}\n",
        "epochs = 15\n",
        "batch_size = 64\n",
        "\n",
        "for act in activation_list:\n",
        "    print(f\"--- Training Model with [{act.upper()}] Activation ---\")\n",
        "    model = build_model(act)\n",
        "    history = model.fit(\n",
        "        X_train, y_train,\n",
        "        epochs=epochs,\n",
        "        batch_size=batch_size,\n",
        "        validation_data=(X_test, y_test),\n",
        "        verbose=1\n",
        "    )\n",
        "    histories[act] = history.history\n",
        "    print(\"\\n\")\n",
        "\n",
        "# 4. Plot Training vs. Validation Loss and Accuracy\n",
        "fig, axes = plt.subplots(1, 2, figsize=(15, 5))\n",
        "fig.suptitle(f\"Activation Function Performance Comparison (Roll No: {STUDENT_ROLL_NO})\", fontsize=14, fontweight='bold')\n",
        "\n",
        "# Plot Accuracy Curves\n",
        "for act in activation_list:\n",
        "    axes[0].plot(histories[act]['accuracy'], label=f'{act.capitalize()} Train', linestyle='--')\n",
        "    axes[0].plot(histories[act]['val_accuracy'], label=f'{act.capitalize()} Val', linewidth=2)\n",
        "axes[0].set_title('Training & Validation Accuracy')\n",
        "axes[0].set_xlabel('Epochs')\n",
        "axes[0].set_ylabel('Accuracy')\n",
        "axes[0].grid(True, linestyle='--', alpha=0.6)\n",
        "axes[0].legend()\n",
        "\n",
        "# Plot Loss Curves\n",
        "for act in activation_list:\n",
        "    axes[1].plot(histories[act]['loss'], label=f'{act.capitalize()} Train', linestyle='--')\n",
        "    axes[1].plot(histories[act]['val_loss'], label=f'{act.capitalize()} Val', linewidth=2)\n",
        "axes[1].set_title('Training & Validation Loss')\n",
        "axes[1].set_xlabel('Epochs')\n",
        "axes[1].set_ylabel('Loss')\n",
        "axes[1].grid(True, linestyle='--', alpha=0.6)\n",
        "axes[1].legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 5. Print Final Summary Table\n",
        "print(\"=\" * 70)\n",
        "print(f\"PERFORMANCE SUMMARY TABLE (Roll No: {STUDENT_ROLL_NO})\")\n",
        "print(\"=\" * 70)\n",
        "print(f\"{'Activation':<12} | {'Train Acc (%)':<15} | {'Val Acc (%)':<15} | {'Train Loss':<12} | {'Val Loss':<12}\")\n",
        "print(\"-\" * 70)\n",
        "for act in activation_list:\n",
        "    final_tr_acc = histories[act]['accuracy'][-1] * 100\n",
        "    final_val_acc = histories[act]['val_accuracy'][-1] * 100\n",
        "    final_tr_loss = histories[act]['loss'][-1]\n",
        "    final_val_loss = histories[act]['val_loss'][-1]\n",
        "    print(f\"{act.capitalize():<12} | {final_tr_acc:<15.2f} | {final_val_acc:<15.2f} | {final_tr_loss:<12.4f} | {final_val_loss:<12.4f}\")\n",
        "print(\"=\" * 70)"
      ],
