      "source": [
        "# ==============================================================================\n",
        "# LAB EXPERIMENT - PART C: COMPARISON OF OPTIMIZATION ALGORITHMS\n",
        "# Student Roll No: YOUR_ROLL_NUMBER_HERE\n",
        "# Framework: TensorFlow / Keras+];'/]\\\\=[]\n",
        "# ==============================================================================\n",
        "\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras import layers, models\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Set student roll number for verification/reproducibility\n",
        "STUDENT_ROLL_NO = \"2024-CS-101\"  # <--- REPLACE WITH YOUR ACTUAL ROLL NUMBER\n",
        "tf.random.set_seed(42)\n",
        "np.random.seed(42)\n",
        "\n",
        "print(f\"Running Experiment for Student Roll No: {STUDENT_ROLL_NO}\")\n",
        "print(f\"TensorFlow Version: {tf.__version__}\\n\")\n",
        "\n",
        "# 1. Load and Preprocess Dataset (Fashion-MNIST)\n",
        "(X_train, y_train), (X_test, y_test) = tf.keras.datasets.fashion_mnist.load_data()\n",
        "\n",
        "# Normalize pixel values to range [0, 1]\n",
        "X_train = X_train / 255.0\n",
        "X_test = X_test / 255.0\n",
        "\n",
        "# 2. Function to Build Base ANN Architecture (Fixed Activation: ReLU)\n",
        "def build_base_model():\n",
        "    model = models.Sequential([\n",
        "        layers.Flatten(input_shape=(28, 28), name=\"input_layer\"),\n",
        "        layers.Dense(128, activation='relu', name=\"hidden_layer_1\"),\n",
        "        layers.Dense(64, activation='relu', name=\"hidden_layer_2\"),\n",
        "        layers.Dense(10, activation='softmax', name=\"output_layer\")\n",
        "    ])\n",
        "    return model\n",
        "\n",
        "# 3. Dictionary of Optimizers to Compare\n",
        "learning_rate = 0.001\n",
        "\n",
        "optimizers_dict = {\n",
        "    'SGD': tf.keras.optimizers.SGD(learning_rate=learning_rate),\n",
        "    'Momentum': tf.keras.optimizers.SGD(learning_rate=learning_rate, momentum=0.9),\n",
        "    'RMSprop': tf.keras.optimizers.RMSprop(learning_rate=learning_rate),\n",
        "    'Adam': tf.keras.optimizers.Adam(learning_rate=learning_rate)\n",
        "}\n",
        "\n",
        "histories = {}\n",
        "epochs = 15\n",
        "batch_size = 64\n",
        "\n",
        "# 4. Train Models across Optimizers\n",
        "for opt_name, optimizer_instance in optimizers_dict.items():\n",
        "    print(f\"--- Training Model with [{opt_name.upper()}] Optimizer ---\")\n",
        "    model = build_base_model()\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=optimizer_instance,\n",
        "        loss='sparse_categorical_crossentropy',\n",
        "        metrics=['accuracy']\n",
        "    )\n",
        "\n",
        "    history = model.fit(\n",
        "        X_train, y_train,\n",
        "        epochs=epochs,\n",
        "        batch_size=batch_size,\n",
        "        validation_data=(X_test, y_test),\n",
        "        verbose=1\n",
        "    )\n",
        "    histories[opt_name] = history.history\n",
        "    print(\"\\n\")\n",
        "\n",
        "# 5. Visualization: Loss vs Epoch & Accuracy vs Epoch\n",
        "fig, axes = plt.subplots(1, 2, figsize=(16, 5))\n",
        "fig.suptitle(f\"Optimizer Performance Comparison (Roll No: {STUDENT_ROLL_NO})\", fontsize=14, fontweight='bold')\n",
        "\n",
        "# Plot Loss vs Epoch\n",
        "for opt_name in optimizers_dict.keys():\n",
        "    axes[0].plot(histories[opt_name]['loss'], label=f'{opt_name} Train', linestyle='--')\n",
        "    axes[0].plot(histories[opt_name]['val_loss'], label=f'{opt_name} Val', linewidth=2)\n",
        "axes[0].set_title('Loss vs. Epoch')\n",
        "axes[0].set_xlabel('Epochs')\n",
        "axes[0].set_ylabel('Cross-Entropy Loss')\n",
        "axes[0].grid(True, linestyle='--', alpha=0.6)\n",
        "axes[0].legend()\n",
        "\n",
        "# Plot Accuracy vs Epoch\n",
        "for opt_name in optimizers_dict.keys():\n",
        "    axes[1].plot(histories[opt_name]['accuracy'], label=f'{opt_name} Train', linestyle='--')\n",
        "    axes[1].plot(histories[opt_name]['val_accuracy'], label=f'{opt_name} Val', linewidth=2)\n",
        "axes[1].set_title('Accuracy vs. Epoch')\n",
        "axes[1].set_xlabel('Epochs')\n",
        "axes[1].set_ylabel('Accuracy')\n",
        "axes[1].grid(True, linestyle='--', alpha=0.6)\n",
        "axes[1].legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# 6. Print Summary Comparison Table\n",
        "print(\"=\" * 80)\n",
        "print(f\"PERFORMANCE SUMMARY TABLE (Roll No: {STUDENT_ROLL_NO})\")\n",
        "print(\"=\" * 80)\n",
        "print(f\"{'Optimizer':<12} | {'Train Acc (%)':<15} | {'Val Acc (%)':<15} | {'Train Loss':<12} | {'Val Loss':<12}\")\n",
        "print(\"-\" * 80)\n",
        "for opt_name in optimizers_dict.keys():\n",
        "    final_tr_acc = histories[opt_name]['accuracy'][-1] * 100\n",
        "    final_val_acc = histories[opt_name]['val_accuracy'][-1] * 100\n",
        "    final_tr_loss = histories[opt_name]['loss'][-1]\n",
        "    final_val_loss = histories[opt_name]['val_loss'][-1]\n",
        "    print(f\"{opt_name:<12} | {final_tr_acc:<15.2f} | {final_val_acc:<15.2f} | {final_tr_loss:<12.4f} | {final_val_loss:<12.4f}\")\n",
        "print(\"=\" * 80)"
