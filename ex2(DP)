        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Define activation functions\n",
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-x))\n",
        "\n",
        "def sigmoid_derivative(x):\n",
        "    s = sigmoid(x)\n",
        "    return s * (1 - s)\n",
        "\n",
        "def tanh(x):\n",
        "    return np.tanh(x)\n",
        "\n",
        "def tanh_derivative(x):\n",
        "    return 1 - np.tanh(x)**2\n",
        "\n",
        "def relu(x):\n",
        "    return np.maximum(0, x)\n",
        "\n",
        "def relu_derivative(x):\n",
        "    return np.where(x > 0, 1.0, 0.0)\n",
        "\n",
        "# Input domain\n",
        "x = np.linspace(-6, 6, 500)\n",
        "\n",
        "# Create plots\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "# Plot Activation Functions\n",
        "axes[0].plot(x, sigmoid(x), label='Sigmoid', color='#1f77b4', linewidth=2)\n",
        "axes[0].plot(x, tanh(x), label='Tanh', color='#ff7f0e', linewidth=2)\n",
        "axes[0].plot(x, relu(x), label='ReLU', color='#2ca02c', linewidth=2)\n",
        "axes[0].set_title('Activation Functions $f(x)$', fontsize=14)\n",
        "axes[0].set_xlabel('Input ($x$)')\n",
        "axes[0].set_ylabel('Output')\n",
        "axes[0].set_ylim(-1.5, 2.0)\n",
        "axes[0].grid(True, linestyle='--', alpha=0.6)\n",
        "axes[0].legend(fontsize=11)\n",
        "\n",
        "# Plot Derivatives (Gradients)\n",
        "axes[1].plot(x, sigmoid_derivative(x), label=\"Sigmoid' (Max: 0.25)\", color='#1f77b4', linestyle='--', linewidth=2)\n",
        "axes[1].plot(x, tanh_derivative(x), label=\"Tanh' (Max: 1.0)\", color='#ff7f0e', linestyle='--', linewidth=2)\n",
        "axes[1].plot(x, relu_derivative(x), label=\"ReLU'\", color='#2ca02c', linestyle='--', linewidth=2)\n",
        "axes[1].set_title('Gradients $f\\'(x)$', fontsize=14)\n",
        "axes[1].set_xlabel('Input ($x$)')\n",
        "axes[1].set_ylabel('Gradient Value')\n",
        "axes[1].set_ylim(-0.2, 1.2)\n",
        "axes[1].grid(True, linestyle='--', alpha=0.6)\n",
        "axes[1].legend(fontsize=11)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
